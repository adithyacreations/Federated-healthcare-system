# Local defaults. Use DEBUG=false and set the HTTPS frontend origin on the host.
DEBUG=true
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_URL=http://localhost:3000
# Optional comma-separated overrides. If omitted, CORS uses FRONTEND_URL and local origins in debug mode.
# CORS_ALLOWED_ORIGINS=
# CSRF_TRUSTED_ORIGINS=
# Enable when the trusted reverse proxy sets and sanitizes X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=false
# Defaults to true when DEBUG=false. Disable only if HTTPS is enforced upstream.
# SECURE_SSL_REDIRECT=
# PostgreSQL and Redis connection strings go on the backend host only.
DATABASE_URL=
REDIS_URL=
# Absolute path on a persistent volume if local uploads must survive redeploys.
DJANGO_MEDIA_ROOT=

FEDERCARE_ADMIN_EMAIL=
FEDERCARE_ADMIN_PASSWORD=
# FEDERCARE_ADMIN_NAME=Platform Super Admin
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
